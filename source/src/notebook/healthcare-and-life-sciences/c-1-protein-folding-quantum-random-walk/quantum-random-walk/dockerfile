# KNOWN VULNERABLE, LEFT AS-IS: this image's job entry point
# (QfoldHybridJobs.qfoldhybridjobs:main, referenced by ../protein-folding-hybrid-jobs.ipynb)
# does not exist anywhere in this repo, and that notebook's own `!cp ... QfoldHybridJobs/psi4`
# setup cell fails on a fresh checkout -- this container cannot currently run at all.
# qiskit==0.34.2 bundles a qiskit-terra with an unpatched RCE (GHSA-6m2c-76ff-6vrf); the only
# fix (qiskit>=1.4.2) needs Python>=3.9, but tensorflow==1.15.0 never shipped a wheel past
# Python 3.7, so no Python version here can satisfy both. Fixing this for real requires
# reconstructing a working entry point and porting off TF 1.15 to TF 2.x first.
FROM 292282985366.dkr.ecr.us-west-2.amazonaws.com/amazon-braket-base-jobs:1.0-cpu-py37-ubuntu18.04

RUN python3 -m pip install --upgrade pip

RUN python3 -m pip install numpy==1.22.3 \
    scipy==1.5.4 \
    tensorflow==1.15.0 \
    Keras==2.0.8 \
    qiskit==0.34.2 \
    qiskit-aer==0.10.3 \
    matplotlib==3.3.4 \
    bokeh==2.3.3

COPY QfoldHybridJobs/psi4 /home/ubuntu/psi4conda/bin/psi4